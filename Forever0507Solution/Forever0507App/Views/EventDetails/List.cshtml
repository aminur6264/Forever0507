@using Forever0507App.Models
@{
    ViewData["Title"] = "রেজিস্ট্রেশন তালিকা";
    var rows = (List<Registration>)ViewBag.Rows!;
    var district = (string)ViewBag.District!;
    var school = (string)ViewBag.School!;
    var page = (int)ViewBag.Page!;
    var pageSize = (int)ViewBag.PageSize!;
    var totalPages = (int)ViewBag.TotalPages!;
    var totalCount = (int)ViewBag.TotalCount!;
}

<div class="page-hero">
    <div class="container">
        <h1 class="page-hero__title h2 mb-1">
            @if (district != "" && school != "")
            {
                @(district + " — " + school)
            }
            else if (district != "")
            {
                @(district + " জেলার তালিকা")
            }
            else if (school != "")
            {
                @(school + " — তালিকা")
            }
            else
            {
                <span>সব অনুমোদিত রেজিস্ট্রেশন</span>
            }
        </h1>
        <p class="page-hero__sub mb-0">মোট @totalCount টি অনুমোদিত রেজিস্ট্রেশন।</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="form-panel">
            @if (rows.Count == 0)
            {
                <p class="mb-0" style="color: var(--brand-muted);">এই তালিকায় কোনো অনুমোদিত রেজিস্ট্রেশন নেই।</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">নাম</th>
                                <th scope="col">জেলা</th>
                                <th scope="col">স্কুলের নাম</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reg in rows)
                            {
                                <tr>
                                    <td class="text-nowrap">@reg.FullName</td>
                                    <td class="text-nowrap">@reg.District</td>
                                    <td>@reg.SchoolName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
                    <div class="small" style="color: var(--brand-muted);">
                        পৃষ্ঠা @(page) / @(totalPages)
                    </div>
                    <nav aria-label="পেজিনেশন">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(page <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-controller="EventDetails" asp-action="List"
                                   asp-route-district="@district" asp-route-school="@school"
                                   asp-route-page="@(page - 1)" asp-route-pageSize="@pageSize">পূর্ববর্তী</a>
                            </li>
                            <li class="page-item disabled"><span class="page-link">@(page)</span></li>
                            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-controller="EventDetails" asp-action="List"
                                   asp-route-district="@district" asp-route-school="@school"
                                   asp-route-page="@(page + 1)" asp-route-pageSize="@pageSize">পরবর্তী</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>

        <div class="mt-3">
            <a asp-controller="EventDetails" asp-action="Index" class="btn btn-outline-secondary">← সারসংক্ষেপে ফিরুন</a>
        </div>
    </div>
</section>

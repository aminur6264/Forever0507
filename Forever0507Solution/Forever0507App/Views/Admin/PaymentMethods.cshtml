@{
    ViewData["Title"] = "পেমেন্ট মাধ্যম";
    var paymentMethods = (List<PaymentMethod>)ViewBag.PaymentMethods!;
    var mediums = (List<PaymentMediumOption>)ViewBag.Mediums!;
    var editing = ViewBag.Editing as PaymentMethod;
}

<div class="page-hero">
    <div class="container">
        <h1 class="page-hero__title h2 mb-1">পেমেন্ট মাধ্যম</h1>
        <p class="page-hero__sub mb-0">কমিটির মোবাইল ব্যাংকিং অ্যাকাউন্টসমূহ — যোগ ও সম্পাদনা।</p>
    </div>
</div>

<section class="section">
    <div class="container">

        @if (TempData["Flash"] is string flash)
        {
            <div class="alert alert-success rounded-4" role="alert">✓ @flash</div>
        }
        @if (TempData["FlashError"] is string flashError)
        {
            <div class="alert alert-danger rounded-4" role="alert">✕ @flashError</div>
        }

        <div class="form-panel mb-4">
            <h2 class="h5 fw-bold mb-3" style="color: var(--brand-deep);">
                @(editing is null ? "নতুন পেমেন্ট মাধ্যম যোগ করুন" : $"পেমেন্ট মাধ্যম সম্পাদনা (আইডি {BengaliText.ToBengaliDigits(editing.Id)})")
            </h2>
            <form asp-controller="Admin" asp-action="SavePaymentMethod" method="post" class="row g-3 align-items-end" novalidate>
                <input type="hidden" name="Id" value="@(editing?.Id ?? 0)" />
                <div class="col-md-4">
                    <label class="form-label" for="AccountName">অ্যাকাউন্ট নাম (হোল্ডার)</label>
                    <input type="text" name="AccountName" id="AccountName" class="form-control" required
                           value="@editing?.AccountName" placeholder="যেমন: মোঃ রাকিব হাসান" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="AccountNumber">অ্যাকাউন্ট নম্বর</label>
                    <input type="text" name="AccountNumber" id="AccountNumber" class="form-control" required
                           inputmode="numeric" maxlength="11" value="@editing?.AccountNumber" placeholder="01712345678" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="Type">টাইপ</label>
                    <select name="Type" id="Type" class="form-select" required>
                        <option value="">— টাইপ নির্বাচন করুন —</option>
                        <option value="@PaymentMethod.Personal" selected="@(editing?.Type == PaymentMethod.Personal)">@PaymentMethod.Personal</option>
                        <option value="@PaymentMethod.Merchant" selected="@(editing?.Type == PaymentMethod.Merchant)">@PaymentMethod.Merchant</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="MfsName">এমএফএস নাম</label>
                    <select name="MfsName" id="MfsName" class="form-select" required>
                        <option value="">— এমএফএস নির্বাচন করুন —</option>
                        @foreach (var medium in mediums)
                        {
                            <option value="@medium.Name" selected="@(editing?.MfsName == medium.Name)">@medium.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-green w-100">@(editing is null ? "যোগ করুন" : "আপডেট করুন")</button>
                </div>
                @if (editing is not null)
                {
                    <div class="col-12">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label" for="BalanceView">ব্যালেন্স</label>
                                <input type="text" id="BalanceView" class="form-control" readonly tabindex="-1"
                                       value="৳@editing.Balance.ToString("N0")" />
                                <div class="form-text">ব্যালেন্স এখান থেকে পরিবর্তন করা যায় না — ডিফল্ট ৳0।</div>
                            </div>
                            <div class="col-md-3 align-self-end">
                                <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="PaymentMethods">নতুন যোগে ফিরুন</a>
                            </div>
                        </div>
                    </div>
                }
            </form>
        </div>

        <div class="form-panel">
            <h2 class="h5 fw-bold mb-3" style="color: var(--brand-deep);">পেমেন্ট মাধ্যম তালিকা</h2>
            @if (paymentMethods.Count == 0)
            {
                <p class="mb-0" style="color: var(--brand-muted);">এখনো কোনো পেমেন্ট মাধ্যম যোগ করা হয়নি।</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">অ্যাকাউন্ট নাম</th>
                                <th scope="col">অ্যাকাউন্ট নম্বর</th>
                                <th scope="col">টাইপ</th>
                                <th scope="col">এমএফএস নাম</th>
                                <th scope="col">ব্যালেন্স</th>
                                <th scope="col">স্ট্যাটাস</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pm in paymentMethods)
                            {
                                <tr>
                                    <td class="fw-semibold">@pm.AccountName</td>
                                    <td>@pm.AccountNumber</td>
                                    <td><span class="badge @(pm.Type == PaymentMethod.Merchant ? "text-bg-dark" : "text-bg-secondary")">@pm.Type</span></td>
                                    <td>@pm.MfsName</td>
                                    <td>৳@pm.Balance.ToString("N0")</td>
                                    <td>
                                        <form asp-controller="Admin" asp-action="TogglePaymentMethodStatus" asp-route-id="@pm.Id" method="post" class="d-inline align-middle">
                                            <span class="badge @(pm.IsActive ? "text-bg-success" : "text-bg-secondary") me-2">@(pm.IsActive ? "চালু" : "বন্ধ")</span>
                                            <div class="form-check form-switch d-inline-block m-0 align-middle">
                                                <input class="form-check-input" type="checkbox" role="switch" name="on" value="1" @(pm.IsActive ? "checked" : "")
                                                       onchange="if (confirm('@(pm.IsActive ? $"{pm.MfsName} অ্যাকাউন্ট বন্ধ করবেন?" : $"{pm.MfsName} অ্যাকাউন্ট চালু করবেন?")')) this.form.submit(); else this.checked = !this.checked;"
                                                       title="চালু ↔ বন্ধ" />
                                            </div>
                                        </form>
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-green" asp-controller="Admin" asp-action="PaymentMethods" asp-route-edit="@pm.Id">সম্পাদনা</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>

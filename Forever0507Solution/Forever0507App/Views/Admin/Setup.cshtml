@{
    ViewData["Title"] = "সেটআপ";
}

<div class="page-hero">
    <div class="container">
        <h1 class="page-hero__title h2 mb-1">সেটআপ</h1>
        <p class="page-hero__sub mb-0">সাইটের কনটেন্ট ও কনফিগারেশন ব্যবস্থাপনা — নিচের যেকোনো বিভাগে প্রবেশ করুন।</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6">
                <a class="d-block h-100 text-decoration-none" asp-controller="Admin" asp-action="Event">
                    <div class="benefit-card h-100 mb-0">
                        <span class="benefit-card__icon benefit-card__icon--emoji">📅</span>
                        <h3 class="benefit-card__title">ইভেন্ট</h3>
                        <p class="benefit-card__text mb-0" style="color: var(--brand-muted);">
                            ইভেন্টের নাম, ট্যাগলাইন, সময়, ভেন্যু ও যোগাযোগের তথ্য — সাইটজুড়ে ব্যবহৃত।
                        </p>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <a class="d-block h-100 text-decoration-none" asp-controller="Admin" asp-action="WelcomeNotes">
                    <div class="benefit-card h-100 mb-0">
                        <span class="benefit-card__icon benefit-card__icon--emoji">📝</span>
                        <h3 class="benefit-card__title">ওয়েলকাম নোট</h3>
                        <p class="benefit-card__text mb-0" style="color: var(--brand-muted);">
                            হোম পেজের শুভেচ্ছাবার্তা — বার্তা, নাম, পদবি ও প্রোফাইল ছবিসহ।
                        </p>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <a class="d-block h-100 text-decoration-none" asp-controller="Admin" asp-action="WhyJoin">
                    <div class="benefit-card h-100 mb-0">
                        <span class="benefit-card__icon benefit-card__icon--emoji">🌟</span>
                        <h3 class="benefit-card__title">কেন যোগ দেবেন</h3>
                        <p class="benefit-card__text mb-0" style="color: var(--brand-muted);">
                            হোম পেজের বেনিফিট কার্ড — আইকন, শিরোনাম ও বর্ণনাসহ চালু/বন্ধ।
                        </p>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <a class="d-block h-100 text-decoration-none" asp-controller="Admin" asp-action="JerseySizes">
                    <div class="benefit-card h-100 mb-0">
                        <span class="benefit-card__icon benefit-card__icon--emoji">🎽</span>
                        <h3 class="benefit-card__title">জার্সি সাইজ</h3>
                        <p class="benefit-card__text mb-0" style="color: var(--brand-muted);">
                            রেজিস্ট্রেশন ফর্মের সাইজ অপশন — যোগ, সম্পাদনা ও চালু/বন্ধ।
                        </p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

@using Forever0507App.Controllers
@{
    ViewData["Title"] = "রেজিস্ট্রেশন লিস্ট";
    var registrations = (List<Registration>)ViewBag.Registrations!;
    var approverNames = (Dictionary<string, string>)ViewBag.ApproverNames!;
    var mediums = (List<string>)ViewBag.Mediums!;
    var approvers = (List<string>)ViewBag.Approvers!;
    var phone = (string?)ViewBag.Phone ?? "";
    var medium = (string?)ViewBag.Medium ?? "";
    var fromAccount = (string?)ViewBag.From ?? "";
    var toAccount = (string?)ViewBag.To ?? "";
    var status = (string?)ViewBag.Status ?? "";
    var approverFilter = (string?)ViewBag.Approver ?? "";
    var hasFilter = phone != "" || medium != "" || fromAccount != "" || toAccount != "" || status != "" || approverFilter != "";
}

<div class="page-hero">
    <div class="container">
        <h1 class="page-hero__title h2 mb-1">রেজিস্ট্রেশন লিস্ট</h1>
        <p class="page-hero__sub mb-0">সব রেজিস্ট্রেশন — অনুমোদন দিলে কার্ড দেখা যাবে, প্রত্যাখ্যান করলে আর যাবে না।</p>
    </div>
</div>

<section class="section">
    <div class="container">

        @if (TempData["Flash"] is string flash)
        {
            <div class="alert alert-success rounded-4" role="alert">✓ @flash</div>
        }
        @if (TempData["FlashError"] is string flashError)
        {
            <div class="alert alert-danger rounded-4" role="alert">✕ @flashError</div>
        }

        <div class="form-panel mb-4">
            <h2 class="h5 fw-bold mb-3" style="color: var(--brand-deep);">ফিল্টার</h2>
            <form asp-controller="Admin" asp-action="Registrations" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="phone">ফোন নম্বর</label>
                    <input type="text" name="phone" id="phone" class="form-control" value="@phone" placeholder="যেকোনো অংশ দিয়ে খুঁজুন" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="medium">পেমেন্ট মাধ্যম</label>
                    <select name="medium" id="medium" class="form-select">
                        <option value="">সব</option>
                        @foreach (var m in mediums)
                        {
                            <option value="@m" selected="@(medium == m)">@m</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="fromAccount">ফ্রম অ্যাকাউন্ট</label>
                    <input type="text" name="fromAccount" id="fromAccount" class="form-control" value="@fromAccount" placeholder="যেকোনো অংশ দিয়ে খুঁজুন" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="toAccount">টু অ্যাকাউন্ট</label>
                    <input type="text" name="toAccount" id="toAccount" class="form-control" value="@toAccount" placeholder="যেকোনো অংশ দিয়ে খুঁজুন" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="status">অনুমোদন স্ট্যাটাস</label>
                    <select name="status" id="status" class="form-select">
                        <option value="">সব</option>
                        <option value="pending" selected="@(status == "pending")">অপেক্ষমান</option>
                        <option value="approved" selected="@(status == "approved")">অনুমোদিত</option>
                        <option value="rejected" selected="@(status == "rejected")">প্রত্যাখ্যাত</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="approver">অনুমোদন দিয়েছেন</label>
                    <select name="approver" id="approver" class="form-select">
                        <option value="">সব</option>
                        @foreach (var a in approvers)
                        {
                            <option value="@a" selected="@(approverFilter == a)">@approverNames.GetValueOrDefault(a, a)</option>
                        }
                    </select>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-green">ফিল্টার করুন</button>
                    <a asp-controller="Admin" asp-action="Registrations" class="btn btn-outline-secondary">রিসেট</a>
                </div>
            </form>
        </div>

        <div class="form-panel">
            @if (registrations.Count == 0)
            {
                <p class="mb-0" style="color: var(--brand-muted);">@(hasFilter ? "ফিল্টারের সাথে মেলে এমন কোনো রেজিস্ট্রেশন পাওয়া যায়নি।" : "এখনো কোনো রেজিস্ট্রেশন হয়নি।")</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">রেজি. নম্বর</th>
                                <th scope="col">নাম</th>
                                <th scope="col">ফোন</th>
                                <th scope="col">ইমেইল</th>
                                <th scope="col">পেমেন্ট মাধ্যম</th>
                                <th scope="col">টাকার পরিমাণ</th>
                                <th scope="col">অনুমোদন</th>
                                <th scope="col">ট্রানজেকশন আইডি</th>
                                <th scope="col">অনুমোদনকারী ও সময়</th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reg in registrations)
                            {
                                <tr>
                                    <td class="fw-semibold">@reg.RegistrationNo</td>
                                    <td>@reg.FullName</td>
                                    <td>@reg.Phone</td>
                                    <td>@(string.IsNullOrEmpty(reg.Email) ? "—" : reg.Email)</td>
                                    @* All registration figures render in plain ASCII digits. *@
                                    <td>@reg.PaymentMedium</td>
                                    <td>৳@reg.PayableAmount.ToString("N0")</td>

                                    <td>
                                        <span class="badge @(reg.ApprovalStatus switch
                                        {
                                            Registration.ApprovalApproved => "text-bg-success",
                                            Registration.ApprovalRejected => "text-bg-danger",
                                            _ => "text-bg-secondary",
                                        })">@(reg.ApprovalStatus ?? "অপেক্ষমান")</span>
                                    </td>
                                    <td class="text-nowrap">@reg.TransactionId</td>
                                    <td class="text-nowrap">
                                        @if (reg.ApprovalAt is DateTime decidedAt)
                                        {
                                            var approver = approverNames.GetValueOrDefault(reg.ApprovalBy ?? "", reg.ApprovalBy ?? "—");
                                            <span>@approver</span>
                                            <div class="small text-muted">@decidedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        }
                                        else
                                        {
                                            <span style="color: var(--brand-muted);">—</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        @if (reg.ApprovalStatus is null)
                                        {
                                            @* Decision is still open — either way is final. *@
                                            <form asp-controller="Admin" asp-action="ApproveRegistration" asp-route-id="@reg.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('@reg.FullName (@reg.RegistrationNo) কে অনুমোদন করবেন? এটি আর বদলানো যাবে না।');">
                                                <button type="submit" class="btn btn-sm btn-outline-green">অনুমোদন</button>
                                            </form>
                                            <form asp-controller="Admin" asp-action="RejectRegistration" asp-route-id="@reg.Id" method="post" class="d-inline ms-1"
                                                  onsubmit="return confirm('@reg.FullName (@reg.RegistrationNo) কে প্রত্যাখ্যান করবেন? এটি আর বদলানো যাবে না, কার্ড দেখা যাবে না।');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">প্রত্যাখ্যান</button>
                                            </form>
                                        }
                                        else if (reg.ApprovalStatus == Registration.ApprovalApproved)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Registration" asp-action="Card" asp-route-id="@reg.RegistrationNo">কার্ড</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>

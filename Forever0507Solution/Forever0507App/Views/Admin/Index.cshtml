@using Forever0507App.Controllers
@{
    ViewData["Title"] = "অ্যাডমিন ড্যাশবোর্ড";
    var users = (List<AppUser>)ViewBag.Users!;
    var registrations = (List<Registration>)ViewBag.Registrations!;
}

<div class="page-hero">
    <div class="container">
        <h1 class="page-hero__title h2 mb-1">অ্যাডমিন ড্যাশবোর্ড</h1>
        <p class="page-hero__sub mb-0">@AuthConstants.AdminDisplayName — ব্যবহারকারী ও রেজিস্ট্রেশন ব্যবস্থাপনা।</p>
    </div>
</div>

<section class="section">
    <div class="container">

        @if (TempData["Flash"] is string flash)
        {
            <div class="alert alert-success rounded-4" role="alert">✓ @flash</div>
        }
        @if (TempData["FlashError"] is string flashError)
        {
            <div class="alert alert-danger rounded-4" role="alert">✕ @flashError</div>
        }

        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.ToBengaliDigits((int)ViewBag.TotalRegistrations)</span>
                    <span class="stat-tile__lbl">মোট রেজিস্ট্রেশন</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.ToBengaliDigits((int)ViewBag.VerifiedCount)</span>
                    <span class="stat-tile__lbl">পেমেন্ট যাচাইকৃত</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.Taka((decimal)ViewBag.TotalPayable)</span>
                    <span class="stat-tile__lbl">মোট প্রদেয়</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.ToBengaliDigits(users.Count)</span>
                    <span class="stat-tile__lbl">সিস্টেম ব্যবহারকারী</span>
                </div>
            </div>
        </div>

        <div class="form-panel mb-4">
            <h2 class="h5 fw-bold mb-3" style="color: var(--brand-deep);">নতুন ব্যবহারকারী তৈরি করুন</h2>
            <form asp-controller="Admin" asp-action="CreateUser" method="post" class="row g-3 align-items-end" novalidate>
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="col-md-5">
                    <label class="form-label" for="Phone">ফোন নম্বর (ইউজারনেম)</label>
                    <input type="text" name="Phone" id="Phone" class="form-control" maxlength="11" placeholder="01712345678" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="Password">প্রাথমিক পাসওয়ার্ড</label>
                    <input type="text" name="Password" id="Password" class="form-control" placeholder="যেকোনো সহজ পাসওয়ার্ড" required />
                    <div class="form-text">প্রথম লগইনে ব্যবহারকারী নিজের পাসওয়ার্ড বদলে নেবে।</div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-green w-100">তৈরি করুন</button>
                </div>
            </form>
        </div>

        <div class="form-panel mb-4">
            <h2 class="h5 fw-bold mb-3" style="color: var(--brand-deep);">ব্যবহারকারীগণ</h2>
            @if (users.Count == 0)
            {
                <p class="mb-0" style="color: var(--brand-muted);">এখনো কোনো ব্যবহারকারী যোগ করা হয়নি।</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">ফোন (ইউজারনেম)</th>
                                <th scope="col">তৈরি</th>
                                <th scope="col">পাসওয়ার্ড অবস্থা</th>
                                <th scope="col" style="min-width: 340px;">ব্যবস্থাপনা</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in users)
                            {
                                <tr>
                                    <td class="fw-semibold">@user.Phone</td>
                                    <td>@BengaliText.ToBengaliDigits(user.CreatedAt.ToString("dd MMM yyyy"))</td>
                                    <td>
                                        @if (user.MustChangePassword)
                                        {
                                            <span class="badge text-bg-warning">পরিবর্তন বাকি</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success">সেট করেছে</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-controller="Admin" asp-action="ResetPassword" method="post" class="d-flex gap-2">
                                            <input type="hidden" name="Id" value="@user.Id" />
                                            <input type="text" name="NewPassword" class="form-control form-control-sm" placeholder="নতুন পাসওয়ার্ড" required />
                                            <button type="submit" class="btn btn-sm btn-outline-green text-nowrap">রিসেট</button>
                                        </form>
                                        <form asp-controller="Admin" asp-action="DeleteUser" method="post" class="mt-2"
                                              onsubmit="return confirm('@user.Phone অ্যাকাউন্টটি মুছে ফেলবেন?');">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">মুছে ফেলুন</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="form-panel">
            <h2 class="h5 fw-bold mb-3" style="color: var(--brand-deep);">সাম্প্রতিক রেজিস্ট্রেশন (সর্বশেষ ৫০)</h2>
            @if (registrations.Count == 0)
            {
                <p class="mb-0" style="color: var(--brand-muted);">এখনো কোনো রেজিস্ট্রেশন হয়নি।</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">রেজি. নম্বর</th>
                                <th scope="col">নাম</th>
                                <th scope="col">ফোন</th>
                                <th scope="col">প্রদেয়</th>
                                <th scope="col">পেমেন্ট</th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reg in registrations)
                            {
                                <tr>
                                    <td class="fw-semibold">@reg.RegistrationNo</td>
                                    <td>@reg.FullName</td>
                                    <td>@reg.Phone</td>
                                    <td>@BengaliText.Taka(reg.PayableAmount)</td>
                                    <td>
                                        <span class="badge @(reg.PaymentStatus == AdminController.PaymentVerified ? "text-bg-success" : "text-bg-warning")">@reg.PaymentStatus</span>
                                    </td>
                                    <td class="text-end">
                                        <form asp-controller="Admin" asp-action="TogglePayment" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@reg.RegistrationNo" />
                                            <button type="submit" class="btn btn-sm @(reg.PaymentStatus == AdminController.PaymentVerified ? "btn-outline-secondary" : "btn-outline-green")">
                                                @(reg.PaymentStatus == AdminController.PaymentVerified ? "অনিশ্চিত করুন" : "যাচাই করুন")
                                            </button>
                                        </form>
                                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Registration" asp-action="Card" asp-route-id="@reg.RegistrationNo">কার্ড</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>

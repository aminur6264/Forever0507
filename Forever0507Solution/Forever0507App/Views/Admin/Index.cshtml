@using Forever0507App.Controllers
@{
    ViewData["Title"] = "অ্যাডমিন ড্যাশবোর্ড";
}

<div class="page-hero">
    <div class="container">
        <h1 class="page-hero__title h2 mb-1">অ্যাডমিন ড্যাশবোর্ড</h1>
        <p class="page-hero__sub mb-0">@AuthConstants.AdminDisplayName — ব্যবহারকারী ও রেজিস্ট্রেশন ব্যবস্থাপনা।</p>
    </div>
</div>

<section class="section">
    <div class="container">

        @if (TempData["Flash"] is string flash)
        {
            <div class="alert alert-success rounded-4" role="alert">✓ @flash</div>
        }
        @if (TempData["FlashError"] is string flashError)
        {
            <div class="alert alert-danger rounded-4" role="alert">✕ @flashError</div>
        }

        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.ToBengaliDigits((int)ViewBag.TotalRegistrations)</span>
                    <span class="stat-tile__lbl">মোট রেজিস্ট্রেশন</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.ToBengaliDigits((int)ViewBag.VerifiedCount)</span>
                    <span class="stat-tile__lbl">পেমেন্ট যাচাইকৃত</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.Taka((decimal)ViewBag.TotalPayable)</span>
                    <span class="stat-tile__lbl">মোট প্রদেয়</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.ToBengaliDigits((int)ViewBag.UserCount)</span>
                    <span class="stat-tile__lbl">সিস্টেম ব্যবহারকারী</span>
                </div>
            </div>
        </div>
    </div>
</section>

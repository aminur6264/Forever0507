@using Forever0507App.Controllers
@{
    ViewData["Title"] = "অ্যাডমিন ড্যাশবোর্ড";
    var districtTally = (List<NameTally>)ViewBag.DistrictTally!;
    var schoolTally = (List<NameTally>)ViewBag.SchoolTally!;
}

<div class="page-hero">
    <div class="container">
        <h1 class="page-hero__title h2 mb-1">অ্যাডমিন ড্যাশবোর্ড</h1>
        <p class="page-hero__sub mb-0">@AuthConstants.AdminDisplayName — ব্যবহারকারী ও রেজিস্ট্রেশন ব্যবস্থাপনা।</p>
    </div>
</div>

<section class="section">
    <div class="container">

        @if (TempData["Flash"] is string flash)
        {
            <div class="alert alert-success rounded-4" role="alert">✓ @flash</div>
        }
        @if (TempData["FlashError"] is string flashError)
        {
            <div class="alert alert-danger rounded-4" role="alert">✕ @flashError</div>
        }

        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.ToBengaliDigits((int)ViewBag.TotalRegistrations)</span>
                    <span class="stat-tile__lbl">মোট রেজিস্ট্রেশন</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.ToBengaliDigits((int)ViewBag.VerifiedCount)</span>
                    <span class="stat-tile__lbl">পেমেন্ট যাচাইকৃত</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.Taka((decimal)ViewBag.TotalPayable)</span>
                    <span class="stat-tile__lbl">মোট প্রদেয়</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.ToBengaliDigits((int)ViewBag.UserCount)</span>
                    <span class="stat-tile__lbl">সিস্টেম ব্যবহারকারী</span>
                </div>
            </div>
        </div>

        @* খরচ সারসংক্ষেপ *@
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.Taka((decimal)ViewBag.KhorochApprovedTotal)</span>
                    <span class="stat-tile__lbl">অনুমোদিত খরচ</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.Taka((decimal)ViewBag.KhorochPendingTotal)</span>
                    <span class="stat-tile__lbl">অপেক্ষমান খরচ · @BengaliText.ToBengaliDigits((int)ViewBag.KhorochPendingCount)টি</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.ToBengaliDigits((int)ViewBag.KhorochRejectedCount)টি</span>
                    <span class="stat-tile__lbl">প্রত্যাখ্যাত খরচ</span>
                </div>
            </div>
            <div class="col-6 col-lg-3 d-flex align-items-center">
                <a class="btn btn-outline-green w-100" asp-controller="Admin" asp-action="Khoroch">সব খরচ দেখুন →</a>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="form-panel h-100">
                    <h2 class="h5 fw-bold mb-3" style="color: var(--brand-deep);">জেলা অনুযায়ী রেজিস্ট্রেশন</h2>
                    @if (districtTally.Count == 0)
                    {
                        <p class="mb-0" style="color: var(--brand-muted);">এখনো কোনো রেজিস্ট্রেশন হয়নি।</p>
                    }
                    else
                    {
                        var maxTotal = districtTally[0].Total;
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">জেলা</th>
                                        <th scope="col" class="text-center">মোট</th>
                                        <th scope="col" class="text-center">অনুমোদিত</th>
                                        <th scope="col" class="text-center">অপেক্ষমান</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in districtTally)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@row.Name</div>
                                                <div class="tally-bar"><span style="width:@(maxTotal > 0 ? row.Total * 100 / maxTotal : 0)%;"></span></div>
                                            </td>
                                            <td class="text-center fw-semibold">
                                                <button type="button" class="btn btn-sm btn-link p-0 fw-semibold js-tally"
                                                        data-type="district" data-name="@row.Name"
                                                        aria-label="@row.Name জেলার তালিকা দেখুন">@BengaliText.ToBengaliDigits(row.Total)</button>
                                            </td>
                                            <td class="text-center fw-semibold">
                                                @if (row.Approved > 0)
                                                {
                                                    <button type="button" class="btn btn-sm btn-link p-0 fw-semibold js-tally"
                                                            data-type="district" data-name="@row.Name" data-status="approved"
                                                            aria-label="@row.Name জেলার অনুমোদিত তালিকা দেখুন">@BengaliText.ToBengaliDigits(row.Approved)</button>
                                                }
                                                else
                                                {
                                                    <span style="color: var(--brand-muted);">@BengaliText.ToBengaliDigits(0)</span>
                                                }
                                            </td>
                                            <td class="text-center fw-semibold">
                                                @if (row.Pending > 0)
                                                {
                                                    <button type="button" class="btn btn-sm btn-link p-0 fw-semibold js-tally"
                                                            data-type="district" data-name="@row.Name" data-status="pending"
                                                            aria-label="@row.Name জেলার অপেক্ষমান তালিকা দেখুন">@BengaliText.ToBengaliDigits(row.Pending)</button>
                                                }
                                                else
                                                {
                                                    <span style="color: var(--brand-muted);">@BengaliText.ToBengaliDigits(0)</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="form-panel h-100">
                    <h2 class="h5 fw-bold mb-3" style="color: var(--brand-deep);">স্কুল অনুযায়ী রেজিস্ট্রেশন</h2>
                    @if (schoolTally.Count == 0)
                    {
                        <p class="mb-0" style="color: var(--brand-muted);">এখনো কোনো রেজিস্ট্রেশন হয়নি।</p>
                    }
                    else
                    {
                        var maxTotal = schoolTally[0].Total;
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">স্কুল</th>
                                        <th scope="col" class="text-center">মোট</th>
                                        <th scope="col" class="text-center">অনুমোদিত</th>
                                        <th scope="col" class="text-center">অপেক্ষমান</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in schoolTally)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@row.Name</div>
                                                <div class="tally-bar"><span style="width:@(maxTotal > 0 ? row.Total * 100 / maxTotal : 0)%;"></span></div>
                                            </td>
                                            <td class="text-center fw-semibold">
                                                <button type="button" class="btn btn-sm btn-link p-0 fw-semibold js-tally"
                                                        data-type="school" data-name="@row.Name"
                                                        aria-label="@row.Name স্কুলের তালিকা দেখুন">@BengaliText.ToBengaliDigits(row.Total)</button>
                                            </td>
                                            <td class="text-center fw-semibold">
                                                @if (row.Approved > 0)
                                                {
                                                    <button type="button" class="btn btn-sm btn-link p-0 fw-semibold js-tally"
                                                            data-type="school" data-name="@row.Name" data-status="approved"
                                                            aria-label="@row.Name স্কুলের অনুমোদিত তালিকা দেখুন">@BengaliText.ToBengaliDigits(row.Approved)</button>
                                                }
                                                else
                                                {
                                                    <span style="color: var(--brand-muted);">@BengaliText.ToBengaliDigits(0)</span>
                                                }
                                            </td>
                                            <td class="text-center fw-semibold">
                                                @if (row.Pending > 0)
                                                {
                                                    <button type="button" class="btn btn-sm btn-link p-0 fw-semibold js-tally"
                                                            data-type="school" data-name="@row.Name" data-status="pending"
                                                            aria-label="@row.Name স্কুলের অপেক্ষমান তালিকা দেখুন">@BengaliText.ToBengaliDigits(row.Pending)</button>
                                                }
                                                else
                                                {
                                                    <span style="color: var(--brand-muted);">@BengaliText.ToBengaliDigits(0)</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="tallyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title" id="tallyModalTitle">রেজিস্ট্রেশন তালিকা</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="বন্ধ করুন"></button>
            </div>
            <div class="modal-body" id="tallyBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('click', async (e) => {
            const button = e.target.closest('.js-tally');
            if (!button) return;

            const body = document.getElementById('tallyBody');
            const title = document.getElementById('tallyModalTitle');
            const statusLabels = { approved: 'অনুমোদিত', pending: 'অপেক্ষমান' };
            const status = button.dataset.status;
            const label = (button.dataset.type === 'school' ? 'স্কুল: ' : 'জেলা: ') + button.dataset.name
                + (statusLabels[status] ? ' — ' + statusLabels[status] : '');
            title.textContent = label;
            body.innerHTML = '<div class="text-center py-4"><div class="spinner-border" role="status"></div></div>';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('tallyModal')).show();

            try {
                const response = await fetch('/Admin/TallyList?type=' + encodeURIComponent(button.dataset.type)
                    + '&name=' + encodeURIComponent(button.dataset.name)
                    + (status ? '&status=' + encodeURIComponent(status) : ''));
                body.innerHTML = response.ok
                    ? await response.text()
                    : '<div class="alert alert-danger mb-0">তালিকা লোড করা যায়নি। আবার চেষ্টা করুন।</div>';
            } catch {
                body.innerHTML = '<div class="alert alert-danger mb-0">তালিকা লোড করা যায়নি। আবার চেষ্টা করুন।</div>';
            }
        });
    </script>
}

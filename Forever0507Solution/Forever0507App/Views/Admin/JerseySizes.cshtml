@{
    ViewData["Title"] = "জার্সি সাইজ";
    var sizes = (List<JerseySizeOption>)ViewBag.JerseySizes!;
    var editing = ViewBag.Editing as JerseySizeOption;
}

<div class="page-hero">
    <div class="container">
        <h1 class="page-hero__title h2 mb-1">জার্সি সাইজ</h1>
        <p class="page-hero__sub mb-0">রেজিস্ট্রেশন ফর্মের জার্সি সাইজ অপশন — বন্ধ করা সাইজ ফর্মে দেখা যাবে না।</p>
    </div>
</div>

<section class="section">
    <div class="container">

        @if (TempData["Flash"] is string flash)
        {
            <div class="alert alert-success rounded-4" role="alert">✓ @flash</div>
        }
        @if (TempData["FlashError"] is string flashError)
        {
            <div class="alert alert-danger rounded-4" role="alert">✕ @flashError</div>
        }

        <div class="form-panel mb-4">
            <h2 class="h5 fw-bold mb-3" style="color: var(--brand-deep);">
                @(editing is null ? "নতুন সাইজ যোগ করুন" : "সাইজ সম্পাদনা")
            </h2>
            <form asp-controller="Admin" asp-action="SaveJerseySize" method="post" novalidate>
                <input type="hidden" name="Id" value="@(editing?.Id ?? 0)" />
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label" for="Value">সাইজ কোড</label>
                        <input type="text" name="Value" id="Value" class="form-control" required maxlength="5"
                               value="@editing?.Value" placeholder="যেমন: XXL" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="Label">লেবেল</label>
                        <input type="text" name="Label" id="Label" class="form-control" required
                               value="@editing?.Label" placeholder="যেমন: ডাবল এক্সট্রা লার্জ (XXL)" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-green w-100">@(editing is null ? "যোগ করুন" : "আপডেট করুন")</button>
                    </div>
                </div>
                @if (editing is not null)
                {
                    <div class="mt-2">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Admin" asp-action="JerseySizes">নতুন যোগে ফিরুন</a>
                    </div>
                }
            </form>
        </div>

        <div class="form-panel">
            <h2 class="h5 fw-bold mb-3" style="color: var(--brand-deep);">সাইজ তালিকা</h2>
            @if (sizes.Count == 0)
            {
                <p class="mb-0" style="color: var(--brand-muted);">কোনো সাইজ নেই — উপরে থেকে যোগ করুন।</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">কোড</th>
                                <th scope="col">লেবেল</th>
                                <th scope="col">ক্রম</th>
                                <th scope="col">স্ট্যাটাস</th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var size in sizes)
                            {
                                <tr>
                                    <td><span class="badge text-bg-dark">@size.Value</span></td>
                                    <td class="fw-semibold">@size.Label</td>
                                    <td>@size.DisplayOrder</td>
                                    <td>
                                        <form asp-controller="Admin" asp-action="ToggleJerseySizeStatus" asp-route-id="@size.Id" method="post" class="d-inline align-middle">
                                            <span class="badge @(size.IsActive ? "text-bg-success" : "text-bg-secondary") me-2">@(size.IsActive ? "চালু" : "বন্ধ")</span>
                                            <div class="form-check form-switch d-inline-block m-0 align-middle">
                                                <input class="form-check-input" type="checkbox" role="switch" name="on" value="1" @(size.IsActive ? "checked" : "")
                                                       onchange="if (confirm('@(size.IsActive ? $"{size.Label} বন্ধ করবেন? ফর্ম থেকে সরে যাবে।" : $"{size.Label} চালু করবেন?")')) this.form.submit(); else this.checked = !this.checked;"
                                                       title="চালু ↔ বন্ধ" />
                                            </div>
                                        </form>
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-green" asp-controller="Admin" asp-action="JerseySizes" asp-route-edit="@size.Id">সম্পাদনা</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>

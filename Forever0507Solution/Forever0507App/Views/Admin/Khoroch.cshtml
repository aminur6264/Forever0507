@using Forever0507App.Controllers
@{
    ViewData["Title"] = "খরচ";
    var khorochs = (List<Khoroch>)ViewBag.Khorochs!;
    var adminNames = (Dictionary<string, string>)ViewBag.AdminNames!;
    var currentUser = (string?)ViewBag.CurrentUser ?? "";
    var sl = 0;

    var approvedKhorochs = khorochs.Where(k => k.Status == Khoroch.Approved).ToList();
    var pendingKhorochs = khorochs.Where(k => k.Status is null).ToList();
    var rejectedKhorochs = khorochs.Where(k => k.Status == Khoroch.Rejected).ToList();
}

<div class="page-hero">
    <div class="container">
        <h1 class="page-hero__title h2 mb-1">খরচ</h1>
        <p class="page-hero__sub mb-0">কমিটির খরচের ইনভয়েস — নির্মাতা ছাড়া অন্য অ্যাডমিন অনুমোদন বা প্রত্যাখ্যান করবেন।</p>
    </div>
</div>

<section class="section">
    <div class="container">

        @if (TempData["Flash"] is string flash)
        {
            <div class="alert alert-success rounded-4" role="alert">✓ @flash</div>
        }
        @if (TempData["FlashError"] is string flashError)
        {
            <div class="alert alert-danger rounded-4" role="alert">✕ @flashError</div>
        }

        @* সারসংক্ষেপ *@
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.Taka(approvedKhorochs.Sum(k => k.Amount))</span>
                    <span class="stat-tile__lbl">অনুমোদিত খরচ · @BengaliText.ToBengaliDigits(approvedKhorochs.Count)টি</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.Taka(pendingKhorochs.Sum(k => k.Amount))</span>
                    <span class="stat-tile__lbl">অপেক্ষমান খরচ · @BengaliText.ToBengaliDigits(pendingKhorochs.Count)টি</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.Taka(rejectedKhorochs.Sum(k => k.Amount))</span>
                    <span class="stat-tile__lbl">প্রত্যাখ্যাত খরচ · @BengaliText.ToBengaliDigits(rejectedKhorochs.Count)টি</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-tile">
                    <span class="stat-tile__num">@BengaliText.ToBengaliDigits(khorochs.Count)টি</span>
                    <span class="stat-tile__lbl">মোট ইনভয়েস</span>
                </div>
            </div>
        </div>

        <div class="form-panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 fw-bold mb-0" style="color: var(--brand-deep);">খরচের তালিকা</h2>
                <a class="btn btn-green" asp-controller="Admin" asp-action="KhorochForm">＋ নতুন খরচ</a>
            </div>

            @if (khorochs.Count == 0)
            {
                <p class="mb-0" style="color: var(--brand-muted);">এখনো কোনো খরচ যোগ করা হয়নি।</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">ক্রম</th>
                                <th scope="col">ইনভয়েস কোড</th>
                                <th scope="col">তারিখ</th>
                                <th scope="col">নির্মাতা</th>
                                <th scope="col">টাকার পরিমাণ</th>
                                <th scope="col">স্ট্যাটাস</th>
                                <th scope="col">অনুমোদন/প্রত্যাখ্যান</th>
                                <th scope="col" class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var khoroch in khorochs)
                            {
                                sl++;
                                var canDecide = khoroch.Status is null && khoroch.CreatedBy != currentUser;
                                var canEdit = khoroch.Status is null && khoroch.CreatedBy == currentUser;
                                var decider = khoroch.ActionBy is null ? null : adminNames.GetValueOrDefault(khoroch.ActionBy, khoroch.ActionBy);
                                <tr>
                                    <td>@BengaliText.ToBengaliDigits(sl)</td>
                                    <td class="fw-semibold text-nowrap">@khoroch.InvoiceCode</td>
                                    <td class="text-nowrap">@khoroch.Date.ToString("dd/MM/yyyy")</td>
                                    <td>@khoroch.CreatedByName</td>
                                    <td class="fw-semibold text-nowrap">৳@khoroch.Amount.ToString("N2")</td>
                                    <td>
                                        <span class="badge @(khoroch.Status switch
                                        {
                                            Khoroch.Approved => "text-bg-success",
                                            Khoroch.Rejected => "text-bg-danger",
                                            _ => "text-bg-secondary",
                                        })">@(khoroch.Status ?? "অপেক্ষমান")</span>
                                    </td>
                                    <td>
                                        @if (decider is not null && khoroch.ActionAt is DateTime decidedAt)
                                        {
                                            <span>@decider</span>
                                            <div class="small text-muted text-nowrap">@decidedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        }
                                        else if (canDecide)
                                        {
                                            <form asp-controller="Admin" asp-action="KhorochApprove" asp-route-id="@khoroch.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-green">অনুমোদন</button>
                                            </form>
                                            <form asp-controller="Admin" asp-action="KhorochReject" asp-route-id="@khoroch.Id" method="post" class="d-inline ms-1">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">প্রত্যাখ্যান</button>
                                            </form>
                                        }
                                        else if (khoroch.CreatedBy == currentUser)
                                        {
                                            <span class="small" style="color: var(--brand-muted);">নিজের খরচ — সিদ্ধান্ত নয়</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        @if (!string.IsNullOrEmpty(khoroch.ImageUrl))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" title="রসিদ দেখুন"
                                                    data-bs-toggle="modal" data-bs-target="#imageModal"
                                                    data-img="@khoroch.ImageUrl" data-code="@khoroch.InvoiceCode">🖼️</button>
                                        }
                                        @if (canEdit)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" title="সম্পাদনা"
                                               asp-controller="Admin" asp-action="KhorochForm" asp-route-edit="@khoroch.Id">✏️</a>
                                        }
                                        <a class="btn btn-sm btn-outline-green ms-1" title="বিস্তারিত"
                                           asp-controller="Admin" asp-action="KhorochDetails" asp-route-id="@khoroch.Id">বিস্তারিত</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>

@* One shared modal — the 🖼️ button's data-img/data-code fill it on open. *@
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-header py-2">
                <h6 class="modal-title" id="imageModalTitle">রসিদ / ছবি</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="বন্ধ"></button>
            </div>
            <div class="modal-body text-center p-3">
                <img id="imageModalImg" class="img-fluid rounded" alt="রসিদ" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('imageModal').addEventListener('show.bs.modal', function (e) {
            var trigger = e.relatedTarget;
            if (!trigger) return;
            document.getElementById('imageModalImg').src = trigger.dataset.img || '';
            document.getElementById('imageModalTitle').textContent = 'রসিদ / ছবি — ' + (trigger.dataset.code || '');
        });
    </script>
}

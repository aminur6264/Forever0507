<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@Event.CommunityName — @Event.EventName। @Event.Tagline।" />
    <title>@ViewData["Title"] - @Event.CommunityName</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Noto+Serif+Bengali:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Forever0507App.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark site-nav sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    @if (!string.IsNullOrEmpty(Event.LogoUrl))
                    {
                        <img src="@Event.LogoUrl" alt="@Event.CommunityName" class="brand-mark brand-mark--img" />
                    }
                    else
                    {
                        <svg class="brand-mark" viewBox="0 0 48 48" role="img" aria-hidden="true">
                            <defs>
                                <linearGradient id="bm-g" x1="0" y1="0" x2="1" y2="1">
                                    <stop offset="0" stop-color="#146b4a" />
                                    <stop offset="1" stop-color="#d4a017" />
                                </linearGradient>
                            </defs>
                            <circle cx="24" cy="24" r="22" fill="url(#bm-g)" />
                            <circle cx="24" cy="24" r="18.5" fill="none" stroke="#faf7f0" stroke-width="1.5" opacity=".85" />
                            <text x="24" y="29" text-anchor="middle" font-size="13" fill="#faf7f0" font-family="'Noto Serif Bengali', serif" font-weight="700">০৫</text>
                        </svg>
                    }
                    <span class="brand-text">
                        <span class="brand-text__name">@Event.CommunityName</span>
                        <small class="brand-text__tag">@Event.Tagline</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="মেনু চালু/বন্ধ করুন">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-flex justify-content-end">
                    <ul class="navbar-nav align-items-lg-center gap-lg-1">
                        @if (User.IsInRole(AuthConstants.AdminRole))
                        {
                            @* Admins work from the management menus only — public pages stay hidden. *@
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">ড্যাশবোর্ড</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Users">ব্যবহারকারী</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Registrations">রেজিস্ট্রেশন লিস্ট</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Khoroch">খরচ</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="PaymentMethods">পেমেন্ট মাধ্যম</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Setup">সেটআপ</a></li>
                            <li class="nav-item ms-lg-2">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-light px-3">লগআউট</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">হোম</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="about">ব্যাচ সম্পর্কে</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="event">আয়োজন</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="fees">ফি ও পেমেন্ট</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Registration" asp-action="Card">রেজিস্ট্রেশন কার্ড</a></li>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="EventDetails" asp-action="Index">ইভেন্ট ডিটেলস</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="MyProfile">আমার প্রোফাইল</a></li>
                                <li class="nav-item ms-lg-2">
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-light px-3">লগআউট</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">লগইন</a></li>
                            }
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-gold btn-sm px-3" asp-controller="Registration" asp-action="Register">রেজিস্ট্রেশন করুন</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <h3 class="site-footer__title">@Event.CommunityName</h3>
                    <p class="site-footer__tagline">@Event.Tagline — @Event.EventName</p>
                    <p class="site-footer__text">
                        @Event.EstablishedNote। স্মৃতি, বন্ধুত্ব আর ভালোবাসাকে একসাথে উদযাপন করতে
                        সারা দেশের ব্যাচমেটদের পাশে থাকুন।
                    </p>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <h4 class="site-footer__heading">দরকারি লিংক</h4>
                    <ul class="site-footer__links">
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="about">ব্যাচ সম্পর্কে</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="fees">অংশগ্রহণ ফি</a></li>
                        <li><a asp-controller="Registration" asp-action="Register">রেজিস্ট্রেশন করুন</a></li>
                        <li><a asp-controller="Registration" asp-action="Card">রেজিস্ট্রেশন কার্ড</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">গোপনীয়তা নীতি</a></li>
                    </ul>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <h4 class="site-footer__heading">যোগাযোগ</h4>
                    <ul class="site-footer__contact">
                        <li>📍 @Event.Venue, @Event.Address</li>
                        <li>📞 @Event.ContactPhone</li>
                        <li>✉️ @Event.ContactEmail</li>
                    </ul>
                    <p class="site-footer__paynote">@Event.PayNote</p>
                </div>
            </div>
        </div>
        <div class="site-footer__bar">
            <div class="container">
                © @BengaliText.ToBengaliDigits(DateTime.Now.Year) @Event.CommunityName · সর্বস্বত্ব সংরক্ষিত
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

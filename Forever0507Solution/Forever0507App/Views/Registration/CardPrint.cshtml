@model Registration
@{
    ViewData["Title"] = $"কার্ড প্রিন্ট/PDF — {Model.RegistrationNo}";
    Layout = "_PrintLayout";
}

<style>
    /* Vivid entry-pass design, scoped here. print-color-adjust keeps the colors in the PDF. */
    .pass {
        width: 100%;
        max-width: 720px;
        margin: 0 auto;
        border-radius: 1.4rem;
        overflow: hidden;
        background: #fff;
        border: 1px solid rgba(11, 61, 46, .22);
        box-shadow: 0 22px 55px rgba(11, 61, 46, .28);
        font-family: 'Hind Siliguri', sans-serif;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    .pass__head {
        background: linear-gradient(135deg, #0b3d2e 0%, #146b4a 55%, #1e8f63 100%);
        color: #faf7f0;
        padding: 1.7rem 1.6rem 1.4rem;
        text-align: center;
        position: relative;
    }

        .pass__head::after {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 12% 20%, rgba(212,160,23,.35) 0, transparent 26%),
                radial-gradient(circle at 88% 80%, rgba(212,160,23,.30) 0, transparent 30%);
            pointer-events: none;
        }

    .pass__emblem {
        width: 72px;
        height: 72px;
        margin: 0 auto .55rem;
        border-radius: 50%;
        background: rgba(250,247,240,.14);
        border: 2.5px solid #d4a017;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Noto Serif Bengali', serif;
        font-size: 1.9rem;
        font-weight: 700;
        color: #faf7f0;
    }

    .pass__title {
        margin: 0;
        font-size: 1.55rem;
        font-weight: 700;
    }

    .pass__tag {
        margin: .15rem 0 0;
        font-size: .85rem;
        opacity: .92;
    }

    .pass__ribbon {
        position: relative;
        z-index: 1;
        display: inline-block;
        margin-top: .7rem;
        padding: .28rem 1.3rem;
        border-radius: 999px;
        background: #d4a017;
        color: #0b3d2e;
        font-weight: 700;
        font-size: .95rem;
        letter-spacing: .02em;
    }

    .pass__regno-band {
        background: #faf7f0;
        border-bottom: 2px solid #d4a017;
        text-align: center;
        padding: .85rem 1rem .95rem;
    }

    .pass__regno-label {
        font-size: .74rem;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: #146b4a;
        font-weight: 600;
    }

    .pass__regno {
        font-family: 'Noto Serif Bengali', serif;
        font-size: 2rem;
        font-weight: 700;
        color: #0b3d2e;
        letter-spacing: .06em;
        line-height: 1.15;
    }

    .pass__body {
        padding: 1.25rem 1.35rem .4rem;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .7rem;
    }

    .chip {
        border: 1.5px solid rgba(20,107,74,.22);
        border-left: 5px solid #d4a017;
        border-radius: .8rem;
        background: #fbfaf5;
        padding: .55rem .8rem;
    }

        .chip--wide {
            grid-column: 1 / -1;
            border-left-color: #146b4a;
        }

    .chip__label {
        font-size: .72rem;
        color: #5c6f66;
        margin: 0 0 .1rem;
    }

    .chip__value {
        margin: 0;
        font-weight: 700;
        font-size: 1.02rem;
        color: #173f31;
        word-break: break-word;
    }

    .pass__foot {
        margin-top: 1rem;
        padding: .9rem 1.35rem 1rem;
        background: linear-gradient(180deg, rgba(212,160,23,.16), rgba(212,160,23,.30));
        border-top: 2px dashed rgba(11,61,46,.30);
        font-size: .84rem;
        color: #173f31;
    }

    .pass__foot-line {
        display: flex;
        gap: .45rem;
        align-items: baseline;
        margin-bottom: .2rem;
    }

    .pass__keep {
        margin: .75rem -1.35rem -.95rem;
        background: #0b3d2e;
        color: #faf7f0;
        text-align: center;
        padding: .5rem 1rem;
        font-size: .78rem;
        letter-spacing: .04em;
    }

    @@media print {
        .pass {
            box-shadow: none;
            max-width: 100%;
            border-radius: 1rem;
        }
    }
</style>

<article class="pass">
    <header class="pass__head">
        <div class="pass__emblem">০৫</div>
        <h1 class="pass__title">@Event.EventName</h1>
        <p class="pass__tag">@Event.Tagline · @Event.CohortLine</p>
        <span class="pass__ribbon">🎟️ অনুমোদিত প্রবেশ কার্ড</span>
    </header>

    <div class="pass__regno-band">
        <div class="pass__regno-label">রেজিস্ট্রেশন নম্বর</div>
        <div class="pass__regno">@Model.RegistrationNo</div>
    </div>

    <div class="pass__body">
        <div class="chip chip--wide">
            <p class="chip__label">👤 নাম</p>
            <p class="chip__value">@Model.FullName</p>
        </div>
        <div class="chip">
            <p class="chip__label">📍 জেলা</p>
            <p class="chip__value">@Model.District</p>
        </div>
        <div class="chip">
            <p class="chip__label">এসএসসি সাল</p>
            <p class="chip__value">@BengaliText.ToBengaliDigits(Model.SscYear)</p>
        </div>
        <div class="chip chip--wide">
            <p class="chip__label">🏫 স্কুল</p>
            <p class="chip__value">@Model.SchoolName</p>
        </div>
        <div class="chip chip--wide">
            <p class="chip__label">📞 মোবাইল</p>
            <p class="chip__value">@Model.Phone</p>
        </div>
    </div>

    <div class="pass__foot">
        <div class="pass__foot-line"><span>📅</span><span><strong>@Event.StartTimeBn</strong>, @Event.StartTimeOnlyBn</span></div>
        <div class="pass__foot-line"><span>📍</span><span>@Event.Venue, @Event.Address</span></div>
        <div class="pass__keep">কার্ডটি সংরক্ষণ করুন — অনুষ্ঠানের দিন গেটে দেখান · যোগাযোগ: @Event.ContactPhone</div>
    </div>
</article>

<div class="d-flex gap-3 justify-content-center mt-4 no-print">
    <button type="button" class="btn btn-green btn-lg px-4" onclick="window.print()">প্রিন্ট / PDF সেভ</button>
    <a class="btn btn-outline-secondary btn-lg px-4" asp-controller="Account" asp-action="MyProfile">প্রোফাইলে ফিরুন</a>
</div>

@model Registration
@{
    ViewData["Title"] = $"রেজিস্ট্রেশন কার্ড — {Model.RegistrationNo}";
}

@* Print outputs ONLY the .pass article: body>header/body>footer targets the layout chrome
   precisely, so the pass's own __head/__foot bands are never caught by a generic hide.
   @page margin:0 keeps the browser from drawing its own date/title/URL headers-footers —
   they live in the margin area; the card gets its own spacing instead. *@
<style>
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 0;
        }

        body {
            background: #fff !important;
        }

        body > header,
        body > footer,
        .no-print,
        .cd {
            display: none !important;
        }

        main {
            padding: 0 !important;
        }

        .section {
            padding: 0 !important;
        }

        .container {
            padding: 0 !important;
            margin: 0 !important;
            max-width: none !important;
        }

        .pass {
            max-width: none !important;
            margin: 10mm !important;
            box-shadow: none !important;
            page-break-inside: avoid;
        }
    }
</style>

<section class="section">
    <div class="container">
        <article class="pass">
            <header class="pass__head">
                @if (!string.IsNullOrEmpty(Event.LogoUrl))
                {
                    <img src="@Event.LogoUrl" alt="@Event.CommunityName" class="pass__logo" />
                }
                else
                {
                    <div class="pass__emblem">০৫</div>
                }
                <h1 class="pass__title">@Event.EventName</h1>
                <p class="pass__tag">@Event.Tagline · @Event.CohortLine</p>
                <span class="pass__ribbon">🎟️ অনুমোদিত প্রবেশ কার্ড</span>
            </header>

            <div class="pass__nameband">
                <div>
                    <div class="pass__label">অংশগ্রহণকারী</div>
                    <div class="pass__name">@Model.FullName</div>
                </div>
                <div class="pass__jersey">
                    <span class="pass__jersey-size">@ViewBag.JerseyLabel</span>
                    <span class="pass__jersey-cap">জার্সি সাইজ</span>
                </div>
            </div>

            <div class="pass__regno-band">
                <div class="pass__label">রেজিস্ট্রেশন নম্বর</div>
                <div class="pass__regno">@Model.RegistrationNo</div>
            </div>

            <div class="pass__grid">
                <div class="pass__chip">
                    <p class="pass__chip-label">📍 জেলা</p>
                    <p class="pass__chip-value">@Model.District</p>
                </div>
                <div class="pass__chip">
                    <p class="pass__chip-label">🎓 এসএসসি সাল</p>
                    <p class="pass__chip-value">@BengaliText.ToBengaliDigits(Model.SscYear)</p>
                </div>
                <div class="pass__chip pass__chip--wide">
                    <p class="pass__chip-label">🏫 স্কুল</p>
                    <p class="pass__chip-value">@Model.SchoolName</p>
                </div>
                @* All registration figures render in plain ASCII digits. *@
                <div class="pass__chip">
                    <p class="pass__chip-label">📞 মোবাইল</p>
                    <p class="pass__chip-value">@Model.Phone</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <div class="pass__chip">
                        <p class="pass__chip-label">✉️ ইমেইল</p>
                        <p class="pass__chip-value">@Model.Email</p>
                    </div>
                }
            </div>

            <div class="pass__when">
                <div class="pass__when-line"><span>📅</span><span><strong>@Event.StartTimeBn</strong>, @Event.StartTimeOnlyBn</span></div>
                <div class="pass__when-line"><span>📍</span><span>@Event.Venue, @Event.Address</span></div>
            </div>

            <footer class="pass__foot">
                কার্ডটি প্রিন্ট করে বা মোবাইলে রেখে অনুষ্ঠানের দিন গেটে দেখান · যোগাযোগ: @Event.ContactPhone
            </footer>
        </article>

        <div class="d-flex gap-3 justify-content-center mt-4 no-print">
            <button type="button" class="btn btn-green btn-lg px-4" onclick="window.print()">প্রিন্ট করুন</button>
            <a class="btn btn-outline-secondary btn-lg px-4" asp-controller="Home" asp-action="Index">হোমে ফিরে যান</a>
        </div>
    </div>
</section>

@{
    ViewData["Title"] = "রেজিস্ট্রেশন কার্ড খুঁজুন";
}

<div class="page-hero">
    <div class="container">
        <h1 class="page-hero__title h2 mb-1">রেজিস্ট্রেশন কার্ড</h1>
        <p class="page-hero__sub mb-0">নিবন্ধন নম্বর, মোবাইল নম্বর অথবা ট্রানজেকশন আইডি দিয়ে আপনার কার্ড খুঁজে নিন।</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="form-panel">
                    @if (ViewBag.Searched is true)
                    {
                        <div class="alert alert-warning rounded-4" role="alert">
                            দুঃখিত, এই তথ্যে কোনো রেজিস্ট্রেশন পাওয়া যায়নি। নম্বরটি মিলিয়ে আবার চেষ্টা করুন।
                        </div>
                    }
                    <form asp-controller="Registration" asp-action="Card" method="get">
                        <label for="q" class="form-label fw-semibold">রেজিস্ট্রেশন নম্বর / মোবাইল / ট্রানজেকশন আইডি</label>
                        <div class="input-group input-group-lg">
                            <input type="text" id="q" name="q" class="form-control" placeholder="REG-2026-0001 · 01712345678 · 9HT7K2XPLM" />
                            <button type="submit" class="btn btn-green">খুঁজুন</button>
                        </div>
                        <div class="form-text mt-2">
                            রেজিস্ট্রেশন নম্বর হারিয়ে ফেললে রেজিস্ট্রেশনের সময় দেওয়া মোবাইল নম্বর বা ট্রানজেকশন আইডি দিয়ে খুঁজুন।
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@model RegistrationInputModel
@{
    ViewData["Title"] = "রেজিস্ট্রেশন ফর্ম";
}

<div class="page-hero">
    <div class="container">
        <h1 class="page-hero__title h2 mb-1">রেজিস্ট্রেশন ফর্ম</h1>
        <p class="page-hero__sub mb-0">@Event.EventName · @Event.StartTimeBn, @Event.StartTimeOnlyBn</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="form-panel">
                    <div class="alert alert-warning border-0 rounded-4 mb-4" role="alert">
                        💳 <strong>পেমেন্ট আগে, ফর্ম পরে:</strong> নিচের যেকোনো নম্বরে অন্তত
                        @BengaliText.Taka(FeeCalculator.MinAmount) পাঠান,
                        তারপর ফর্মে ট্রানজেকশনের তথ্য দিন।
                        <ul class="mb-0 mt-2 ps-3">
                            @{
                                var activeAccounts = ((List<PaymentMethod>)ViewBag.ActivePaymentMethods!)
                                    .GroupBy(p => p.MfsName);
                            }
                            @if (!activeAccounts.Any())
                            {
                                <li>এখনো কোনো সক্রিয় পেমেন্ট অ্যাকাউন্ট নেই — অনুগ্রহ করে আয়োজক কমিটির সাথে যোগাযোগ করুন।</li>
                            }
                            @foreach (var group in activeAccounts)
                            {
                                <li>
                                    <strong>@group.Key</strong>
                                    <ul class="mb-0">
                                        @foreach (var account in group)
                                        {
                                            <li>@account.AccountNumber — @account.AccountName (@account.Type)</li>
                                        }
                                    </ul>
                                </li>
                            }
                        </ul>
                    </div>

                    <form asp-controller="Registration" asp-action="Register" method="post" novalidate>
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label"></label>
                                <input asp-for="FullName" class="form-control" placeholder="যেমন: রাকিব হাসান" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="District" class="form-label"></label>
                                <select asp-for="District" class="form-select">
                                    <option value="">— জেলা নির্বাচন করুন —</option>
                                    @foreach (var district in (List<District>)ViewBag.Districts!)
                                    {
                                        <option value="@district.Name">@district.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="District" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SchoolChoice" class="form-label"></label>
                                <select asp-for="SchoolChoice" class="form-select" id="SchoolChoice">
                                    <option value="">— স্কুল নির্বাচন করুন —</option>
                                    @foreach (var school in (List<School>)ViewBag.Schools!)
                                    {
                                        <option value="@school.Name">@school.Name</option>
                                    }
                                    <option value="@RegistrationInputModel.OtherSchoolValue">অন্যান্য (নিজের স্কুলের নাম লিখুন)</option>
                                </select>
                                <span asp-validation-for="SchoolChoice" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 d-none" id="otherSchoolWrap">
                                <label asp-for="OtherSchoolName" class="form-label"></label>
                                <input asp-for="OtherSchoolName" class="form-control" id="OtherSchoolName"
                                       placeholder="যেমন: টাঙ্গাইল জিলা স্কুল" />
                                <span asp-validation-for="OtherSchoolName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="SscYear">৪. এসএসসি সাল</label>
                                <input type="text" id="SscYear" class="form-control" value="@BengaliText.ToBengaliDigits(Event.SscYear)"
                                       readonly tabindex="-1" aria-readonly="true" />
                                <div class="form-text">এই আয়োজন শুধু @BengaliText.ToBengaliDigits(Event.SscYear) সালের এসএসসি ব্যাচের জন্য।</div>
                            </div>
                            <div class="col-12">
                                <label asp-for="PaymentMedium" class="form-label d-block"></label>
                                <div class="d-flex gap-3 flex-wrap">
                                    @foreach (var medium in (List<string>)ViewBag.PaymentMediums!)
                                    {
                                        <div class="form-check form-check-inline mb-0">
                                            <input class="form-check-input" type="radio" asp-for="PaymentMedium" value="@medium" id="pm-@medium" />
                                            <label class="form-check-label" for="pm-@medium">@medium</label>
                                        </div>
                                    }
                                </div>
                                <span asp-validation-for="PaymentMedium" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FromAccount" class="form-label"></label>
                                <input asp-for="FromAccount" class="form-control" inputmode="numeric" maxlength="11" placeholder="01712345678" required />
                                <span asp-validation-for="FromAccount" class="text-danger small"></span>
                                <div class="form-text">যে নম্বর থেকে টাকা পাঠানো হয়েছে।</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ToAccount" class="form-label"></label>
                                <select asp-for="ToAccount" id="ToAccount" class="form-select" required disabled
                                        data-selected="@Model.ToAccount">
                                    <option value="">— আগে ট্রানজেকশন মাধ্যম নির্বাচন করুন —</option>
                                </select>
                                <span asp-validation-for="ToAccount" class="text-danger small"></span>
                                <div class="form-text">মাধ্যম বেছে নিলে সেই মাধ্যমের কমিটি নম্বরগুলো এখানে দেখা যাবে।</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AmountText" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="AmountText" class="form-control" inputmode="decimal" id="AmountText" placeholder="যেমন: 1500" />
                                    <span class="input-group-text">টাকা</span>
                                </div>
                                <span asp-validation-for="AmountText" class="text-danger small"></span>
                                <div class="form-text">সর্বনিম্ন @BengaliText.Taka(FeeCalculator.MinAmount), শুধু সংখ্যা।</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TransactionId" class="form-label"></label>
                                <input asp-for="TransactionId" class="form-control" placeholder="যেমন: 9HT7K2XPLM" />
                                <span asp-validation-for="TransactionId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label"></label>
                                <input asp-for="Phone" class="form-control" inputmode="numeric" maxlength="11" placeholder="01712345678" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                                <div class="form-text">এই নম্বরেই পেমেন্ট করা ভালো — যাচাইয়ে কাজে লাগবে।</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" maxlength="120" placeholder="name@gmail.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                                <div class="form-text">অনুমোদনের পর এই ইমেইলে লগইন ইউজারনেম ও পাসওয়ার্ড পাঠানো হবে।</div>
                            </div>
                            <div class="col-12">
                                <label asp-for="JerseySize" class="form-label d-block"></label>
                                <div class="d-flex gap-2 flex-wrap">
                                    @foreach (var size in (List<JerseySizeOption>)ViewBag.JerseySizes!)
                                    {
                                        <input type="radio" class="btn-check" asp-for="JerseySize" value="@size.Value" id="js-@size.Value" autocomplete="off" />
                                        <label class="btn btn-outline-green" for="js-@size.Value">@size.Label</label>
                                    }
                                </div>
                                <span asp-validation-for="JerseySize" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NameOnJersey" class="form-label"></label>
                                <input asp-for="NameOnJersey" class="form-control text-uppercase" maxlength="20" placeholder="যেমন: RAHIM UDDIN" />
                                <span asp-validation-for="NameOnJersey" class="text-danger small"></span>
                                <div class="form-text">জার্সিতে যে নাম ছাপা হবে — ইংরেজি বড় হাতের অক্ষরে লিখুন (সর্বোচ্চ ২০ অক্ষর)।</div>
                            </div>
                        </div>

                        <div class="fee-estimate mt-4">
                            <div class="small" style="color: rgba(255,255,255,.7);">@Event.PayNote</div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
                            <button type="submit" class="btn btn-green btn-lg px-5">রেজিস্ট্রেশন সম্পন্ন করুন</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/registration.js" asp-append-version="true"></script>
    <script id="activeAccountsData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(((List<PaymentMethod>)ViewBag.ActivePaymentMethods!).Select(p => new { mfs = p.MfsName, number = p.AccountNumber })))</script>
    <script>
        (function () {
            var dataEl = document.getElementById('activeAccountsData');
            var select = document.getElementById('ToAccount');
            if (!dataEl || !select) return;
            var accounts = JSON.parse(dataEl.textContent);

            // After a failed post the model's posted number should survive the rebuild.
            var pending = select.dataset.selected || '';

            function refresh(resetValue) {
                var keep = resetValue ? '' : select.value;
                var chosen = document.querySelector('input[type="radio"][name="PaymentMedium"]:checked');

                select.innerHTML = '';
                select.add(new Option('— আগে ট্রানজেকশন মাধ্যম নির্বাচন করুন —', ''));

                if (!chosen) {
                    // No transaction way picked yet — the dropdown stays blocked.
                    select.disabled = true;
                    select.value = '';
                    return;
                }

                select.disabled = false;
                accounts
                    .filter(function (a) { return a.mfs === chosen.value; })
                    .forEach(function (a) { select.add(new Option(a.number, a.number)); });

                var wanted = pending || keep;
                pending = '';
                select.value = wanted;
                if (select.selectedIndex === -1) select.value = '';
            }

            document.querySelectorAll('input[type="radio"][name="PaymentMedium"]').forEach(function (radio) {
                radio.addEventListener('change', function () { refresh(true); });
            });
            refresh(false);
        })();
    </script>
}

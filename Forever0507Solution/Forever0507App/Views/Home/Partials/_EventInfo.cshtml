<section class="section section--alt" id="event">
    <div class="container">
        <div class="section-head">
            <span class="section-head__eyebrow">দিন-তারিখ</span>
            <h2 class="section-head__title mt-1">পুনর্মিলনীর তারিখ, সময় ও স্থান</h2>
            <p class="section-head__lead mb-0">
                ক্যালেন্ডারে নোট করে নিন — সেদিন দেখা হবে পুরনো ক্যাম্পাসেই।
            </p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="info-card text-center">
                    <span class="info-card__icon">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                    </span>
                    <h3 class="info-card__title">তারিখ ও সময়</h3>
                    <p class="info-card__body mb-0">
                        @Event.StartTimeBn<br />@Event.StartTimeOnlyBn থেকে সন্ধ্যা পর্যন্ত
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="info-card text-center">
                    <span class="info-card__icon">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" />
                        </svg>
                    </span>
                    <h3 class="info-card__title">স্থান</h3>
                    <p class="info-card__body mb-0">
                        @Event.Venue<br />@Event.Address
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="info-card text-center">
                    <span class="info-card__icon">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
                        </svg>
                    </span>
                    <h3 class="info-card__title">যোগাযোগ</h3>
                    <p class="info-card__body mb-0">
                        @Event.ContactPhone<br />@Event.ContactEmail
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

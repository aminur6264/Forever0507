<section class="section" id="about">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="about-art">
                    <svg viewBox="0 0 560 400" role="img" aria-label="বিদ্যালয়ের ভবনের চিত্র" style="display:block; width:100%; height:auto;">
                        <defs>
                            <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0" stop-color="#bfe3d2" />
                                <stop offset="1" stop-color="#eaf6ef" />
                            </linearGradient>
                            <linearGradient id="wall" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0" stop-color="#fdfaf3" />
                                <stop offset="1" stop-color="#f1e9d8" />
                            </linearGradient>
                        </defs>
                        <rect width="560" height="400" fill="url(#sky)" />
                        <circle cx="470" cy="70" r="34" fill="#f2c94c" opacity=".9" />
                        <ellipse cx="120" cy="70" rx="42" ry="14" fill="#ffffff" opacity=".8" />
                        <ellipse cx="165" cy="82" rx="30" ry="10" fill="#ffffff" opacity=".65" />
                        <rect y="320" width="560" height="80" fill="#9cc9ae" />
                        <!-- main building -->
                        <rect x="150" y="150" width="260" height="170" fill="url(#wall)" stroke="#c9b98f" />
                        <polygon points="140,150 280,96 420,150" fill="#146b4a" />
                        <rect x="150" y="150" width="260" height="10" fill="#0b3d2e" opacity=".15" />
                        <!-- flag -->
                        <rect x="278" y="46" width="4" height="56" fill="#5c6b64" />
                        <polygon points="282,48 322,58 282,70" fill="#d4a017" />
                        <!-- windows: upper row -->
                        <g fill="#7fb8a0" stroke="#146b4a" stroke-width="2">
                            <rect x="172" y="170" width="34" height="42" rx="3" />
                            <rect x="226" y="170" width="34" height="42" rx="3" />
                            <rect x="300" y="170" width="34" height="42" rx="3" />
                            <rect x="354" y="170" width="34" height="42" rx="3" />
                        </g>
                        <!-- door + clock -->
                        <rect x="258" y="238" width="44" height="82" rx="4" fill="#146b4a" />
                        <circle cx="280" cy="264" r="6" fill="#faf7f0" />
                        <circle cx="280" cy="140" r="16" fill="#faf7f0" stroke="#d4a017" stroke-width="2" />
                        <line x1="280" y1="140" x2="280" y2="130" stroke="#0b3d2e" stroke-width="2" />
                        <line x1="280" y1="140" x2="288" y2="142" stroke="#0b3d2e" stroke-width="2" />
                        <!-- windows: lower row -->
                        <g fill="#7fb8a0" stroke="#146b4a" stroke-width="2">
                            <rect x="172" y="238" width="34" height="42" rx="3" />
                            <rect x="354" y="238" width="34" height="42" rx="3" />
                        </g>
                        <!-- side wings -->
                        <rect x="90" y="220" width="60" height="100" fill="#f4eede" stroke="#c9b98f" />
                        <rect x="410" y="220" width="60" height="100" fill="#f4eede" stroke="#c9b98f" />
                        <rect x="102" y="238" width="36" height="30" rx="3" fill="#7fb8a0" stroke="#146b4a" stroke-width="2" />
                        <rect x="422" y="238" width="36" height="30" rx="3" fill="#7fb8a0" stroke="#146b4a" stroke-width="2" />
                        <!-- trees -->
                        <g>
                            <rect x="52" y="286" width="8" height="34" fill="#8a6a4b" />
                            <circle cx="56" cy="272" r="26" fill="#2e8b62" />
                            <rect x="500" y="286" width="8" height="34" fill="#8a6a4b" />
                            <circle cx="504" cy="272" r="26" fill="#2e8b62" />
                        </g>
                        <!-- path -->
                        <polygon points="248,320 312,320 340,400 220,400" fill="#e8dfc8" />
                    </svg>
                </div>
            </div>
            <div class="col-lg-6">
                <span class="section-head__eyebrow">আমাদের বিদ্যালয়</span>
                <h2 class="section-head__title mt-1 mb-3">ঐতিহ্য, শিক্ষা আর সম্পর্কের পাঁচ দশক</h2>
                <p>
                    রামপুর আদর্শ উচ্চ বিদ্যালয় শুধু ইট-কাঠের একটা ভবন নয় — এখানেই হাজারো স্বপ্ন প্রথম ডানা মেলেছে।
                    প্রতিষ্ঠার পর থেকে বিদ্যালয়টি শুধু পাঠদানেই সীমাবদ্ধ থাকেনি; নৈতিকতা, শৃঙ্খলা আর মানবিক মূল্যবোধে
                    গড়ে তুলেছে দেশের কৃতি সন্তান। এই প্রাঙ্গণের প্রতিটি ধুলিকণায় মিশে আছে স্মৃতি, সাফল্য আর অদম্য
                    চেষ্টার গল্প।
                </p>
                <p>
                    প্রতিটি প্রাক্তন শিক্ষার্থী এই বিদ্যালয়ের গর্ব। পুনর্মিলনী-২০২৭ সেই সুযোগ, যখন বছরের পর বছর
                    পরে থাকা বন্ধুরা ফিরে আসবে পুরনো বেঞ্চে, নতুন করে জুড়াবে স্মৃতি, আর গড়ে উঠবে আগামী
                    প্রজন্মের জন্য সহযোগিতার এক জোড়ালো নেটওয়ার্ক।
                </p>
                <div class="row g-3 mt-4">
                    <div class="col-4">
                        <div class="stat-tile">
                            <span class="stat-tile__num">@BengaliText.ToBengaliDigits(Event.EstablishedYear)</span>
                            <span class="stat-tile__lbl">প্রতিষ্ঠার বছর</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-tile">
                            <span class="stat-tile__num">১২০০+</span>
                            <span class="stat-tile__lbl">বর্তমান শিক্ষার্থী</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-tile">
                            <span class="stat-tile__num">১৫০০০+</span>
                            <span class="stat-tile__lbl">প্রাক্তন শিক্ষার্থী</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

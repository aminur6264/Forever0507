@{
    var whyJoinItems = (List<WhyJoinItem>)ViewBag.WhyJoinItems!;
}

@if (whyJoinItems.Count > 0)
{
    <section class="section section--alt" id="benefits">
        <div class="container">
            <div class="section-head">
                <span class="section-head__eyebrow">কেন আসবেন</span>
                <h2 class="section-head__title mt-1">কেন পুনর্মিলনীতে যোগ দেবেন?</h2>
                <p class="section-head__lead mb-0">
                    প্রায় দুই দশক পর পুরো ব্যাচ এক মাঠে — এমন সুযোগ জীবনে আর আসতে পারে না।
                </p>
            </div>
            <div class="row g-4">
                @foreach (var item in whyJoinItems)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="benefit-card">
                            <span class="benefit-card__icon benefit-card__icon--emoji">@item.Icon</span>
                            <h3 class="benefit-card__title">@item.Title</h3>
                            <p class="benefit-card__text mb-0">@item.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@{
    var galleryImages = (List<GalleryImage>)ViewBag.GalleryImages!;
}

@if (galleryImages.Count > 0)
{
    <section class="section section--alt" id="gallery">
        <div class="container">
            <div class="section-head">
                <span class="section-head__eyebrow">গ্যালারি</span>
                <h2 class="section-head__title mt-1">মুহূর্তের ছবি</h2>
            </div>
            <div class="row g-4">
                @foreach (var image in galleryImages)
                {
                    <div class="col-6 col-lg-3">
                        <figure class="form-panel h-100 mb-0 p-2">
                            <button type="button" class="gallery-shot"
                                    data-full="/Image/Gallery/@image.Id" data-caption="@image.Title"
                                    aria-label="@image.Title — বড় করে দেখুন">
                                <img src="/Image/Gallery/@image.Id" alt="@image.Title"
                                     class="w-100 rounded-3" style="height: 180px; object-fit: cover;" />
                            </button>
                            <figcaption class="small text-center mt-2 mb-0 px-1"
                                        style="color: var(--brand-deep);">@image.Title</figcaption>
                        </figure>
                    </div>
                }
            </div>
        </div>
    </section>

    @* Full-screen viewer — site.js fills it from the .gallery-shot buttons above. *@
    <div class="lightbox" id="galleryLightbox" hidden role="dialog" aria-modal="true" aria-label="ছবি ভিউয়ার">
        <button type="button" class="lightbox__close" data-lightbox-close aria-label="বন্ধ করুন">&times;</button>
        <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="আগের ছবি">&#10094;</button>
        <figure class="lightbox__stage">
            <img class="lightbox__img" src="" alt="" />
            <figcaption class="lightbox__caption"></figcaption>
        </figure>
        <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="পরের ছবি">&#10095;</button>
        <div class="lightbox__count"></div>
    </div>
}

@{
    var welcomeNotes = (List<WelcomeNote>)ViewBag.WelcomeNotes!;
}

@if (welcomeNotes.Count > 0)
{
    <section class="section section--alt" id="messages">
        <div class="container">
            <div class="section-head">
                <span class="section-head__eyebrow">শুভেচ্ছাবার্তা</span>
                <h2 class="section-head__title mt-1">ওয়েলকাম নোট</h2>
            </div>
            <div class="row g-4">
                @for (var i = 0; i < welcomeNotes.Count; i++)
                {
                    var note = welcomeNotes[i];
                    var variant = i % 2 == 0 ? "msg-card__avatar--green" : "msg-card__avatar--gold";
                    <div class="col-lg-6">
                        <div class="msg-card">
                            <blockquote class="msg-card__quote mb-0">@note.Message</blockquote>
                            <div class="msg-card__person">
                                @if (!string.IsNullOrEmpty(note.PhotoUrl))
                                {
                                    <span class="msg-card__avatar @variant p-0 overflow-hidden" aria-hidden="true">
                                        <img src="@note.PhotoUrl" alt="@note.Name" style="width:100%;height:100%;object-fit:cover;" />
                                    </span>
                                }
                                else
                                {
                                    <span class="msg-card__avatar @variant" aria-hidden="true">@note.Name[..1]</span>
                                }
                                <div>
                                    <p class="msg-card__name">@note.Name</p>
                                    <p class="msg-card__role">@note.Designation</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

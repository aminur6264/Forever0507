<section class="hero" id="top">
    <div class="container hero__inner text-center">
        <svg class="hero__logo mb-4" viewBox="0 0 120 120" role="img" aria-label="বিদ্যালয়ের প্রতীক">
            <defs>
                <linearGradient id="logo-g" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#d4a017" />
                    <stop offset="1" stop-color="#f3d27c" />
                </linearGradient>
            </defs>
            <circle cx="60" cy="60" r="56" fill="rgba(250,247,240,.08)" stroke="url(#logo-g)" stroke-width="2.5" />
            <circle cx="60" cy="60" r="47" fill="rgba(11,61,46,.35)" stroke="rgba(250,247,240,.5)" stroke-width="1" />
            <text x="60" y="74" text-anchor="middle" font-size="38" fill="#faf7f0" font-family="'Noto Serif Bengali', serif" font-weight="700">রা</text>
            <path d="M28 96 Q60 110 92 96" fill="none" stroke="#d4a017" stroke-width="2" opacity=".8" />
        </svg>

        <div>
            <span class="hero__eyebrow">@Event.Tagline</span>
        </div>

        <h1 class="hero__title display-5 mb-2">@Event.SchoolName</h1>
        <p class="h3 mb-4 fw-semibold" style="color: var(--brand-gold);">@Event.EventName</p>

        <p class="hero__lead mx-auto mb-4">
            ছাত্রজীবনের সোনালি দিনগুলো, হারিয়ে যাওয়া বন্ধুরা আর প্রিয় শিক্ষকদের কথা কি মনে পড়ে?
            সেই পুরনো মাঠে, সেই চেনা করিডোরে সবাইকে আবার একসাথে দেখার দিন ঘনিয়ে এসেছে।
            আজই রেজিস্ট্রেশন করে জোড়ালো করুন চিরন্তন বন্ধন।
        </p>

        <div class="d-flex gap-3 justify-content-center flex-wrap mb-5">
            <a class="btn btn-gold btn-lg px-4" asp-controller="Registration" asp-action="Register">রেজিস্ট্রেশন করুন</a>
            <a class="btn btn-outline-cream btn-lg px-4" asp-controller="Registration" asp-action="Card">রেজিস্ট্রেশন কার্ড ডাউনলোড</a>
        </div>

        <p class="mb-3 fw-semibold" style="color: rgba(255,255,255,.85);">পুনর্মিলনী শুরু হতে আর বাকি:</p>
        <div id="countdown" class="cd justify-content-center" data-start="@Event.StartTimeIso" aria-live="polite">
            <div class="cd__item"><span class="cd__num" data-cd="d">--</span><span class="cd__lbl">দিন</span></div>
            <div class="cd__item"><span class="cd__num" data-cd="h">--</span><span class="cd__lbl">ঘণ্টা</span></div>
            <div class="cd__item"><span class="cd__num" data-cd="m">--</span><span class="cd__lbl">মিনিট</span></div>
            <div class="cd__item"><span class="cd__num" data-cd="s">--</span><span class="cd__lbl">সেকেন্ড</span></div>
        </div>
    </div>
</section>

<section class="section" id="fees">
    <div class="container">
        <div class="section-head">
            <span class="section-head__eyebrow">রেজিস্ট্রেশন</span>
            <h2 class="section-head__title mt-1">কারা রেজিস্ট্রেশন করতে পারবেন?</h2>
            <p class="section-head__lead mb-0">
                যাঁরা <strong>২০০৫ সালে এসএসসি</strong> এবং <strong>২০০৭ সালে এইচএসসি</strong> পাস করেছেন —
                দেশের যেকোনো জেলার, যেকোনো স্কুলের ব্যাচমেটরাই এই আয়োজনে অংশ নিতে পারবেন।
            </p>
        </div>

        <div class="row g-4 g-lg-5 mt-2">
            <div class="col-sm-6 col-lg-3">
                <div class="fee-card">
                    <h3 class="fee-card__group">মূল অংশগ্রহণ ফি</h3>
                    <p class="fee-card__sub">সর্বনিম্ন @BengaliText.Taka(FeeCalculator.MinAmount) — ইচ্ছা করলে বেশি দিতে পারেন</p>
                    <p class="fee-card__fee-label">অতিরিক্ত অর্থ</p>
                    <p class="fee-card__amount mb-0">ব্যাচ কল্যাণ তহবিলে</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="fee-card">
                    <h3 class="fee-card__group">প্রদেয় পরিমাণ</h3>
                    <p class="fee-card__sub">মূল ফি + ২% মোবাইল ব্যাংকিং সার্ভিস চার্জ</p>
                    <p class="fee-card__fee-label">যেমন</p>
                    <p class="fee-card__amount mb-0">৳১,০০০ → ৳১,০২০</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="fee-card">
                    <span class="fee-card__badge">ফ্রি</span>
                    <h3 class="fee-card__group">জার্সি অন্তর্ভুক্ত</h3>
                    <p class="fee-card__sub">রেজিস্ট্রেশনের সাথেই ব্যাচ জার্সি</p>
                    <p class="fee-card__fee-label">সাইজ</p>
                    <p class="fee-card__amount mb-0">S - XXL</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="fee-card fee-card--free">
                    <h3 class="fee-card__group">পেমেন্ট মাধ্যম</h3>
                    <p class="fee-card__sub">যেকোনো একটি মাধ্যম বেছে নিন</p>
                    <p class="fee-card__fee-label">সমর্থিত</p>
                    <p class="fee-card__amount mb-0">বিকাশ · নগদ · রকেট</p>
                </div>
            </div>
        </div>

        <div class="alert alert-success border-0 shadow-sm rounded-4 mt-5 mx-auto" style="max-width: 52rem;" role="alert">
            💳 <strong>পেমেন্ট নির্দেশনা:</strong> নিচের যেকোনো নম্বরে অংশগ্রহণ ফি পাঠিয়ে ফর্মে
            ট্রানজেকশন আইডি দিন।
            <ul class="mb-0 mt-2 ps-3">
                @foreach (var account in Event.PaymentAccounts)
                {
                    <li>@account</li>
                }
            </ul>
            <div class="mt-2">@Event.PayNote</div>
        </div>

        <div class="text-center mt-4">
            <a class="btn btn-green btn-lg px-5" asp-controller="Registration" asp-action="Register">এখনই রেজিস্ট্রেশন করুন</a>
        </div>
    </div>
</section>
